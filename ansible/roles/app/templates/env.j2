# {{ ansible_managed }}
# Loaded by systemd via EnvironmentFile. The app does not read .env files itself.
LISTEN_HOST={{ app_listen_host }}
PORT={{ app_port }}
DATABASE_URL=postgres://{{ db_user }}:{{ db_password | urlencode }}@{{ db_private_ip }}:5432/{{ db_name }}?sslmode=require
JWT_SECRET={{ jwt_secret }}
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

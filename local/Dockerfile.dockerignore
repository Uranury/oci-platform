# Used by BuildKit for local/Dockerfile (build context is the repo root).
# Only what `go build ./cmd/app` needs goes in.
*
!go.mod
!go.sum
!cmd/
!internal/
!migrations/
!pkg/
!web/
**/*_test.go
# The frontend is built inside the image (local/Dockerfile's web stage);
# host node_modules (platform-specific binaries) and dist stay out.
web/node_modules/
web/dist/app/
